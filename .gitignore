.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Frontend build and dependency artifacts
**/node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/playwright-report/
/frontend/test-results/
/frontend/.firebase/
/backend/data/
/backend/app/data/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log

# Local environment and secret files
.env
.env.*
*.env
!.env.example
!/frontend/.env.firebase
/backend/app/src/main/resources/secret/

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
