{
  "name": "town-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "hosting:serve": "npm run build && npx --yes firebase-tools@15.26.0 serve --only hosting --project town-ai",
    "hosting:preview": "npm run build && npx --yes firebase-tools@15.26.0 hosting:channel:deploy manual-preview --project town-ai --expires 1d",
    "hosting:deploy": "npm run build && npx --yes firebase-tools@15.26.0 deploy --only hosting --project town-ai"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "9.33.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
